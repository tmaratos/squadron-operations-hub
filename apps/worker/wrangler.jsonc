{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "squadron-operations-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "squadron-operations-hub",
     "database_id": "ed944b79-6948-4aa9-b27b-9c73ff012d72"
    }
  ],
  "triggers": {
    "crons": ["15 9 * * *"]
  }
}
