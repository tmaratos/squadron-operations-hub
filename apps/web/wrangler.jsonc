{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "squadron-operations-hub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Private link to the squadron AI server (Ollama on hp-server) through the hp-server Cloudflare Tunnel.
  // Whisper, for browsers that cannot do speech themselves. Held inside Cloudflare's free daily allowance
  // by the Hub's own budget, not by trusting people to dictate less.
  "ai": {
    "binding": "AI"
  },
  "vpc_services": [
    {
      "binding": "SQUADRON_AI",
      "service_id": "01a0a81c-0b70-7c91-b79a-eedf0c537649"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "squadron-operations-hub",
      "database_id": "ed944b79-6948-4aa9-b27b-9c73ff012d72",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NAME": "Squadron Operations Hub",
    "APP_URL": "https://tn170adminhub.tristanmaratos.com",
    "SESSION_TTL_HOURS": "12",
    "GOOGLE_REDIRECT_URI": "https://tn170adminhub.tristanmaratos.com/api/auth/google/callback",
    "GOOGLE_SHARED_DRIVE_ID": "0ALYSj1KARR19Uk9PVA",
    "ALLOWED_EMAIL_DOMAINS": "cap.gov",
    // Cloudflare Access, for signing in with a personal address. Neither of these is a secret: the team
    // domain is where Cloudflare publishes its signing keys, and the audience is the identifier of the
    // Access application. Both are checked on every token so that one minted for another organisation,
    // or for a different application of ours, is refused.
    "CF_ACCESS_TEAM_DOMAIN": "aviationministries.cloudflareaccess.com",
    "CF_ACCESS_AUD": "65355037e9680227c01d0d21c9e8adaeffb17c854c1c9daf94e64ccf73795d6a",
    "GOOGLE_DRIVE_MAX_UPLOAD_MB": "10",
    "NOTIFY_FROM": "TN-170 Operations Hub <hub@tristanmaratos.com>"
  }
}
