{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squadron-notifier",
  "main": "src/index.js",
  "compatibility_date": "2026-07-17",
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Quarter past each hour carries the "as things happen" notices.
    // 11:00 UTC is 06:00 Central, which is when the once-a-day email goes out and deadlines are checked.
    "crons": ["15 * * * *", "0 11 * * *"]
  },
  "vars": {
    "NOTIFY_FROM": "TN-170 Operations Hub <hub@tristanmaratos.com>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "squadron-operations-hub",
      "database_id": "ed944b79-6948-4aa9-b27b-9c73ff012d72"
    }
  ]
}
