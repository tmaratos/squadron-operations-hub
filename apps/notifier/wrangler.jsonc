{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squadron-notifier",
  "main": "src/index.js",
  "compatibility_date": "2026-07-17",
  "observability": {
    "enabled": true
  },
  "triggers": {
    // Hourly, on the hour. The worker itself decides what each run is for, by asking what time it is in
    // Oak Ridge: 6pm there is the end-of-day digest, 6am is the morning one, and every other run just
    // catches up anything the Hub could not send at the time. Daylight saving therefore cannot shift it.
    "crons": ["0 * * * *"]
  },
  "vars": {
    "NOTIFY_FROM": "TN-170 Operations Hub <hub@tristanmaratos.com>"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "squadron-operations-hub",
      "database_id": "ed944b79-6948-4aa9-b27b-9c73ff012d72"
    }
  ]
}
